# Copy to .env (setup.ps1 does this for you). All settings are optional unless noted.
# CLIPFORGE_WORKSPACE_DIR=./workspace
# CLIPFORGE_MODELS_DIR=./models
# CLIPFORGE_WHISPER_MODEL=large-v3-turbo
# CLIPFORGE_WHISPER_DEVICE=auto          # auto | cuda | cpu
# CLIPFORGE_WHISPER_COMPUTE_TYPE=float16 # falls back to int8_float16, then CPU int8
# CLIPFORGE_MAX_DOWNLOAD_HEIGHT=1080
# CLIPFORGE_YTDLP_COOKIES_FILE=C:/path/to/cookies.txt   # for age-restricted / members-only videos
# CLIPFORGE_YTDLP_JS_RUNTIME=node
# CLIPFORGE_JOB_CONCURRENCY=2

# ── LLM keys (one is required for moment scoring) ─────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...          # uses claude-3-5-haiku (recommended, free tier via console)
# GEMINI_API_KEY=AIza...               # uses gemini-2.0-flash  (free tier available)
# OPENAI_API_KEY=sk-...                # uses gpt-4o-mini
# OLLAMA_HOST=http://localhost:11434   # fully offline; set OLLAMA_MODEL=llama3.2 optionally

# ── Optional feature keys ─────────────────────────────────────────────────────
# HF_TOKEN=hf_...                      # speaker diarization (pyannote.audio)
# PEXELS_API_KEY=...                   # AI B-roll (Phase 5)
# PIXABAY_API_KEY=...                  # AI B-roll fallback (Phase 5)
# ELEVENLABS_API_KEY=...               # premium dubbing (Phase 6, free Edge-TTS otherwise)
